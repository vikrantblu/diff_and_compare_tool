Windows Registry Editor Version 5.00

; diff_and_compare_tool - Windows Explorer HKCU Shell Integration Removal

; 1. All Files (*)
[-HKEY_CURRENT_USER\Software\Classes\*\shell\DiffAndCompareToolCompare]
[-HKEY_CURRENT_USER\Software\Classes\*\shell\DiffAndCompareToolSelectLeft]
[-HKEY_CURRENT_USER\Software\Classes\*\shell\DiffAndCompareToolSelectRight]
[-HKEY_CURRENT_USER\Software\Classes\*\shell\BeyondCompareCompare]
[-HKEY_CURRENT_USER\Software\Classes\*\shell\BeyondCompareSelectLeft]
[-HKEY_CURRENT_USER\Software\Classes\*\shell\BeyondCompareSelectRight]
[-HKEY_CURRENT_USER\Software\Classes\*\shell\DiffAndCompareCompare]
[-HKEY_CURRENT_USER\Software\Classes\*\shell\DiffAndCompareSelectLeft]
[-HKEY_CURRENT_USER\Software\Classes\*\shell\DiffAndCompareSelectRight]

; 2. Directories
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\DiffAndCompareToolCompare]
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\DiffAndCompareToolSelectLeft]
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\DiffAndCompareToolSelectRight]
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\BeyondCompareCompare]
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\BeyondCompareSelectLeft]
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\BeyondCompareSelectRight]
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\DiffAndCompareCompare]
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\DiffAndCompareSelectLeft]
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\DiffAndCompareSelectRight]

; 3. Directory Background
